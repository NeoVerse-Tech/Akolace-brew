            <i class="fas fa-coins"></i>
            Estimated Wholesale Total
          </span>

        </div>

        <div class="amount-display">
          ₦{{ formattedPrice.toLocaleString() }}
        </div>

      </div>

      <!-- NOTES -->
      <div class="preorder-field">

        <label>
          <i class="fas fa-note-sticky"></i>
          Additional Notes
        </label>

        <textarea
          v-model="form.notes"
          placeholder="Branch instructions, preferred contact hours, partnership interest..."
          class="notes-area"
        ></textarea>

      </div>

      <!-- SUBMIT -->
      <button
        @click="submitOrder"
        :disabled="loading"
        class="submit-btn"
      >

        <i
          v-if="!loading"
          class="fas fa-paper-plane"
        ></i>

        {{ loading ? 'Submitting...' : 'Submit Supply Request' }}

      </button>

    </div>

    <!-- FOOTER -->
    <footer class="preorder-footer">

      Powered by AKOL’ACE Brew

    </footer>

  </div>

  `,

  data() {

    return {

      loading: false,

      cartonPrice: 8400,

      bottleCount: 12,

      bottleUnitPrice: 700,

      form: {

        business_name: '',
        contact_person: '',
        phone: '',
        email: '',
        business_type: '',
        product_package: '',
        cartons: 1,
        location: '',
        notes: ''

      }

    }

  },

  computed: {

    formattedPrice() {

      return (
        this.cartonPrice *
        Number(this.form.cartons || 1)
      )

    }

  },

  methods: {

    async submitOrder() {

      if (

        !this.form.business_name ||
        !this.form.contact_person ||
        !this.form.phone ||
        !this.form.email ||
        !this.form.business_type ||
        !this.form.product_package

      ) {

        alert(
          "Please complete all required fields."
        )

        return

      }

      this.loading = true

      try {

        const { error } = await window.sb

          .from('pre_orders')

          .insert([{

            business_name:
              this.form.business_name,

            contact_person:
              this.form.contact_person,

            business_phone:
              this.form.phone,

            business_email:
              this.form.email,

            business_type:
              this.form.business_type,

            product_package:
              this.form.product_package,

            cartons:
              this.form.cartons,

            bottles_per_carton:
              this.bottleCount,

            unit_price:
              this.bottleUnitPrice,

            carton_price:
              this.cartonPrice,

            estimated_total:
              this.formattedPrice,

            delivery_address:
              this.form.location,

            additional_notes:
              this.form.notes,

            created_at:
              new Date()

          }])

        if (error) throw error

        alert(
          "Wholesale supply request submitted successfully."
        )

        // RESET FORM
        this.form = {

          business_name: '',
          contact_person: '',
          phone: '',
          email: '',
          business_type: '',
          product_package: '',
          cartons: 1,
          location: '',
          notes: ''

        }

      }

      catch (err) {

        console.error(err)

        alert(
          "Submission failed: " +
          err.message
        )

      }

      finally {

        this.loading = false

      }

    }

  }

};
