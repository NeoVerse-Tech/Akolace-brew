          v-if="!loading"
          class="fas fa-paper-plane"
        ></i>

        {{ loading ? 'Processing...' : 'Submit Pre Order' }}

      </button>

    </div>

    <footer class="preorder-footer">
      Powered by AKOL’ACE Brew
    </footer>

  </div>
  
  `,

  data() {

    return {

      loading: false,

      form: {

        supermarket: '',
        size: '',
        email: '',
        location: '',
        quantity: 1,
        notes: ''

      },

      prices: {

      
        "370ml": 4000

      }

    }

  },

  computed: {

    formattedPrice() {

      if (!this.form.size) return 0

      return (
        this.prices[this.form.size] *
        Number(this.form.quantity || 1)
      )

    }

  },

  methods: {

    async submitOrder() {

      if (
        !this.form.supermarket ||
        !this.form.email ||
        !this.form.size
      ) {

        alert(
          "Please complete the required fields."
        )

        return
      }

      this.loading = true

      try {

        const { error } = await window.sb
          .from('pre_orders')
          .insert([{

            supermarket_name:
              this.form.supermarket,

            product_size:
              this.form.size,

            customer_email:
              this.form.email,

            delivery_location:
              this.form.location,

            quantity:
              this.form.quantity,

            total_price:
              this.formattedPrice,

            additional_notes:
              this.form.notes,

            created_at:
              new Date()

          }])

        if (error) throw error

        alert(
          "Pre Order Submitted Successfully!"
        )

        // RESET FORM
        this.form = {

          supermarket: '',
          size: '',
          email: '',
          location: '',
          quantity: 1,
          notes: ''

        }

      }

      catch (err) {

        console.error(err)

        alert(
          "Submission failed: " +
          err.message
        )

      }

      finally {

        this.loading = false

      }

    }

  }

};


