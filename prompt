        <label>
          <i class="fas fa-location-dot"></i>
          Delivery Location
        </label>

        <input
          type="text"
          v-model="form.location"
          placeholder="Enter supermarket delivery location"
          class="preorder-input"
        >

        <small class="helper-text">
          This is where the supermarket delivery should arrive.
        </small>

      </div>

      <!-- QUANTITY -->
      <div class="preorder-field">

        <label>
          <i class="fas fa-layer-group"></i>
          Quantity
        </label>

        <input
          type="number"
          min="1"
          v-model="form.quantity"
          placeholder="Enter quantity"
          class="preorder-input"
        >

      </div>

      <!-- PRICE -->
      <div class="price-box">

        <div class="price-top">

          <span>
            <i class="fas fa-wallet"></i>
            Estimated Total
          </span>

        </div>

        <div class="amount-display">
          ₦{{ formattedPrice.toLocaleString() }}
        </div>

      </div>

      <!-- NOTES -->
      <div class="preorder-field">

        <label>
          <i class="fas fa-note-sticky"></i>
          Additional Notes
        </label>

        <textarea
          v-model="form.notes"
          placeholder="Extra requests, preferences, or delivery instructions..."
          class="notes-area"
        ></textarea>

      </div>

      <!-- BUTTON -->
      <button
        @click="submitOrder"
        :disabled="loading"
        class="submit-btn"
      >

